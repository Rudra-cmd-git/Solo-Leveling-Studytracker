# ---------------------------------------------------------------------------
# HUNTER SYSTEM - environment template
# Copy to .env.local and fill in the values from your own Supabase project.
# Never commit .env.local. Never put the service-role key in client code.
# ---------------------------------------------------------------------------

# Supabase project URL, e.g. https://abcdefghijklm.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Publishable / anon key (safe for the browser; RLS enforces access)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional server-only secret used by maintenance scripts. Not required by the
# running app: every mutation goes through RLS + SECURITY DEFINER functions.
# SUPABASE_SERVICE_ROLE_KEY=

# Public site origin, used for auth redirect links.
# NEXT_PUBLIC_SITE_URL=http://localhost:3000
